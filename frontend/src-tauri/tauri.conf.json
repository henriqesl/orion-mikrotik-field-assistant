{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORION Field",
  "version": "0.7.0",
  "identifier": "br.com.bionic.orion-field",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run desktop:engine && npm run desktop:backend",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ORION Field",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#08111f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/orion-backend", "binaries/orion-network-engine"],
    "resources": {
      "binaries/orion-backend-runtime": "orion-backend-runtime"
    },
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2ODlGOTc5RUZFOUNBNjcKUldSbnl1bnZlZm1KOXJHZTdaQVZEQVhBeGdNN2VBb0E2cWJvRDgrWkNPVjltUHJZS3NNd3Q4UHkK",
      "endpoints": [
        "https://github.com/henriqesl/orion-mikrotik-field-assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
